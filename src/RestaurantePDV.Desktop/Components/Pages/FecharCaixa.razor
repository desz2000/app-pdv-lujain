@page "/fechar-caixa"
@inject IPdvApi Api
@inject PinState Pin
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Fechar caixa — PDV Lujain</PageTitle>

@if (!Pin.Autenticado)
{
    <LoginPin />
}
else
{
    <h1>Fechar caixa</h1>

    <p>Gere o relatório Excel com o dashboard do dia.</p>

    <div class="filtros-data">
        <label>Data:</label>
        <input type="date" @bind="data" />
        <button class="primary" @onclick="BaixarAsync" disabled="@baixando">
            @(baixando ? "Gerando..." : "Baixar Excel do dia")
        </button>
    </div>

    @if (!string.IsNullOrEmpty(mensagem))
    {
        <div class="mensagem">@mensagem</div>
    }
}

@code {
    private DateTime data = DateTime.Today;
    private bool baixando;
    private string? mensagem;

    protected override void OnInitialized()
    {
        Pin.Mudou += OnPinChanged;
    }

    private async void OnPinChanged() => await InvokeAsync(StateHasChanged);

    private async Task BaixarAsync()
    {
        mensagem = null;
        baixando = true;
        try
        {
            var bytes = await Api.BaixarRelatorioExcelAsync(data);
            if (bytes is null)
            {
                mensagem = "Não foi possível gerar o relatório.";
                return;
            }
            var fileName = $"relatorio-{data:yyyy-MM-dd}.xlsx";
            await JS.InvokeVoidAsync("baixarArquivo", fileName, Convert.ToBase64String(bytes));
            mensagem = $"Relatório {fileName} gerado.";
        }
        catch (Exception ex)
        {
            mensagem = $"Erro: {ex.Message}";
        }
        finally
        {
            baixando = false;
        }
    }

    public void Dispose()
    {
        Pin.Mudou -= OnPinChanged;
    }
}
